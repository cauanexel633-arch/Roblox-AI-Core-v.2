# Copy this file to .env for local development. Never commit .env.
ENVIRONMENT=development
PARTH_API_KEY=replace-with-a-long-random-secret

OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=openrouter/free
# Optional comma-separated fallback models, for example: provider/model-a,provider/model-b
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://your-project.vercel.app
OPENROUTER_APP_NAME=PARTH AI
REQUEST_TIMEOUT=45
MAX_RETRIES=2
MAX_DESCRIPTION_LENGTH=240

# Optional persistence. If blank, API works without durable storage (development only).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_WEAPONS_TABLE=weapons
SUPABASE_REQUESTS_TABLE=weapon_requests
SUPABASE_MAPS_TABLE=generated_maps
SUPABASE_EVENTS_TABLE=generated_events

# Optional comma-separated browser origins. Roblox HttpService does not use CORS.
CORS_ORIGINS_RAW=
LOG_LEVEL=INFO
